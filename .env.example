# ============================================================================
# AZURE OPENAI & AD CREDS
# ============================================================================
AZURE_API_VERSION="2024-02-15-preview"
AZURE_ENDPOINT="https://your-azure-openai-endpoint.openai.azure.com/"
AZURE_MODEL="gpt-4-turbo"
DGW_SUBSCRIPTION_KEY="your-apim-subscription-key"

# Azure Active Directory (Service Principal for long-running token refreshes)
SP_TENANT_ID="your-aad-tenant-id"
SP_CLIENT_ID="your-aad-client-id"
SP_CLIENT_SECRET="your-aad-client-secret"
AZURE_SCOPE="https://cognitiveservices.azure.com/.default"

# ============================================================================
# GRAPH DATABASE CONFIGURATION
# ============================================================================
NEO4J_URI="bolt://localhost:7687"
NEO4J_USER="neo4j"
NEO4J_PASSWORD="password"

# ============================================================================
# INGESTION DATA SOURCE STREAMS
# ============================================================================
DATA_FEED_WATCH="data/multi_hazard_stream.log"
